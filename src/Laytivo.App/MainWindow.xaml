<Window x:Class="Laytivo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laytivo – Desktop-Anordnung" Width="1000" Height="820" MinWidth="740" MinHeight="560"
        Background="#F6F8FB" Foreground="#192D40" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" Icon="Assets/Laytivo.ico">
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/Laytivo.png" Width="42" Height="42" Margin="0,0,12,0" />
        <TextBlock Text="Laytivo" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="Dein Desktop. Wieder an seinem Platz." FontSize="16" Foreground="#54697D" Margin="0,3,0,10" />
      <TextBlock Text="Programme öffnen → Fenster manuell positionieren → Auswahl speichern" TextWrapping="Wrap" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#E7EEF5" CornerRadius="6" Padding="14" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="Status" />
        <TextBlock Text="Fenster schließen blendet Laytivo aus. Beenden ist über das Tray-Menü möglich." FontSize="12" Foreground="#54697D" Margin="0,8,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Gespeicherte Anordnung">
          <StackPanel>
            <TextBlock Text="{Binding ProfileSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding SavedWindows}" Margin="0,10">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Gespeicherte Anordnung wiederherstellen" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="Restore" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Aktuelle Fenster auswählen">
          <StackPanel>
            <WrapPanel Margin="0,0,0,10">
              <Button Content="Fensterliste aktualisieren" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="Refresh" />
              <Button Content="Auswahl als Anordnung speichern" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveLayout" />
            </WrapPanel>
            <TextBlock Text="Erneutes Speichern ersetzt das Standardprofil. Die Auswahl enthält keine Fensterinhalte. Fehlende Startinformationen sind gekennzeichnet." TextWrapping="Wrap" Foreground="#54697D" FontSize="12" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Windows}" IsEnabled="{Binding IsIdle}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#D7E0E8" BorderThickness="0,0,0,1" Padding="0,7">
                    <CheckBox IsChecked="{Binding Selected}">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Application}" FontSize="12" Foreground="#54697D" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Monitor}" FontSize="11" Foreground="#54697D" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PlacementStatus}" FontSize="12" Foreground="#54697D" />
                        <TextBlock Text="{Binding LaunchStatus}" FontSize="12" Foreground="#54697D" TextWrapping="Wrap" />
                        <Expander Header="Optionale Startinformationen" FontSize="12" Margin="0,6,0,0">
                          <StackPanel Margin="0,6">
                            <TextBlock Text="Startargumente (optional, z. B. ein Dokumentpfad)" />
                            <TextBox Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,7" Padding="5" />
                            <TextBlock Text="Arbeitsverzeichnis" />
                            <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="5" />
                          </StackPanel>
                        </Expander>
                      </StackPanel>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Einstellungen">
          <StackPanel>
            <StackPanel IsEnabled="{Binding IsIdle}">
              <CheckBox Content="Laytivo mit Windows starten" IsChecked="{Binding StartWithWindows}" AutomationProperties.AutomationId="StartWithWindows" />
              <CheckBox Content="Gespeicherte Anordnung nach Anmeldung wiederherstellen" IsChecked="{Binding RestoreAfterLogin}" />
              <CheckBox Content="Fehlende Programme automatisch starten" IsChecked="{Binding LaunchMissingApps}" AutomationProperties.AutomationId="LaunchMissingApps" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                <TextBlock Text="Startverzögerung nach Anmeldung (Sekunden)" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding DelayOptions}" SelectedItem="{Binding StartupDelaySeconds}" Width="70" Padding="6" />
              </StackPanel>
            </StackPanel>
            <Button Content="Einstellungen übernehmen" Command="{Binding ApplySettingsCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Status und lokale Daten">
          <StackPanel>
            <TextBlock Text="{Binding LastRestore}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding RestoreDetails}" Margin="0,8">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Konfiguration und begrenzte JSON-Protokolle:" FontSize="12" Foreground="#54697D" />
            <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="12" />
            <Button Content="Fehlerhafte Konfiguration archivieren und neu beginnen" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,12,0,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding ConfigurationBlocked}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
